# ============================================================================
# ALAMZ TECH — Apache / LiteSpeed config for Hostinger
# ----------------------------------------------------------------------------
# GitHub Pages handled HTTPS and the www redirect on its own. Hostinger does
# not, so those move here. Every block is wrapped in <IfModule> — if a module
# is missing, the rule is skipped rather than throwing a 500 that takes the
# whole site down.
#
# Not used by GitHub Pages, so it is harmless to leave in the repo either way.
# ============================================================================

# --- Force HTTPS, and the bare domain -------------------------------------
# The canonical tag in index.html names https://alamztech.com with no www.
# These redirects make the server agree with it; if they disagree, search
# engines see two sites and split the ranking between them.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https  (HTTPS=off is how Hostinger's proxy reports a plain request)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www -> bare
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --- Caching ---------------------------------------------------------------
# Assets are versioned with ?v= in index.html, so they can be cached hard: a
# change bumps the token and the URL becomes new. HTML must NOT be cached that
# way, or visitors keep an old page that points at asset versions we have
# already replaced.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Modest hardening. No CSP here: the site loads nothing third-party, and a
  # wrong CSP breaks the page silently, so it is not worth the risk for this.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Tidiness --------------------------------------------------------------
# No directory listings, and keep the build scripts out of public view. They
# contain nothing secret, but they are not part of the site.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tools/ - [F,L]
</IfModule>

# Never serve these as downloadable text.
<FilesMatch "^\.(htaccess|nojekyll)$|^CNAME$">
  Require all denied
</FilesMatch>
